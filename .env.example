QDRANT_URL=http://qdrant:6333
COLLECTION_NAME=inbox_docs
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=
CHUNK_SIZE=1400
CHUNK_OVERLAP=200
MIN_CHUNK_CHARS=80
ENABLE_OCR=1
OCR_LANG=kor+eng
OCR_MIN_TEXT_CHARS=1
WATCH_INTERVAL_SECONDS=120
ENABLE_STT=1
STT_ENABLE_KOSPACING=1
# Multi-model ensemble: comma-separated list (takes priority over STT_MODEL)
# Recommended: medium,large-v2,large-v3,distil-large-v3
STT_MODELS=medium,large-v2,large-v3,distil-large-v3
# Fallback single-model (used when STT_MODELS is not set)
STT_MODEL=small
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
STT_LANGUAGE=ko
STT_CHUNK_SECONDS=180
STT_BEAM_SIZE=10
# Korean-optimized transcription parameters
STT_TEMPERATURE=0.0
STT_COMPRESSION_RATIO_THRESHOLD=2.2
STT_INITIAL_PROMPT=다음은 한국어 음성입니다.
# Ensemble voting parameters
STT_MIN_VOTES=2
STT_MIN_AVG_LOGPROB=-0.8
STT_MAX_NO_SPEECH_PROB=0.3
STT_ALIGN_TOLERANCE=0.5
STT_SIMILARITY_THRESHOLD=0.6
